# returns the smallest power of two greater than or equal to n
function next_pow2(n) {
    size = 1;
    while size < n {
        size <<= 1;
    }
    return size;
}

# ============================================================
# exact arithmetic in Z[w] where w is a primitive 8th root
# of unity, so w^4 = -1 and w^8 = 1
#
# representation:
# [a, b, c, d] = a + b*w + c*w^2 + d*w^3
# ============================================================

function z8_zero() {
    return [0, 0, 0, 0];
}

function z8_from_int(x) {
    return [x, 0, 0, 0];
}

function z8_add(x, y) {
    return [
        x[0] + y[0],
        x[1] + y[1],
        x[2] + y[2],
        x[3] + y[3]
    ];
}

function z8_sub(x, y) {
    return [
        x[0] - y[0],
        x[1] - y[1],
        x[2] - y[2],
        x[3] - y[3]
    ];
}

function z8_div_int(x, n) {
    return [
        x[0] / n,
        x[1] / n,
        x[2] / n,
        x[3] / n
    ];
}

# multiply two elements modulo w^4 = -1
function z8_mul(x, y) {
    c0 = 0;
    c1 = 0;
    c2 = 0;
    c3 = 0;
    c4 = 0;
    c5 = 0;
    c6 = 0;

    c0 = x[0] * y[0];
    c1 = x[0] * y[1] + x[1] * y[0];
    c2 = x[0] * y[2] + x[1] * y[1] + x[2] * y[0];
    c3 = x[0] * y[3] + x[1] * y[2] + x[2] * y[1] + x[3] * y[0];
    c4 = x[1] * y[3] + x[2] * y[2] + x[3] * y[1];
    c5 = x[2] * y[3] + x[3] * y[2];
    c6 = x[3] * y[3];

    return [
        c0 - c4,
        c1 - c5,
        c2 - c6,
        c3
    ];
}

function z8_pow(k) {
    t = k % 8;

    if t == 0 {
        return [1, 0, 0, 0];
    }

    if t == 1 {
        return [0, 1, 0, 0];
    }

    if t == 2 {
        return [0, 0, 1, 0];
    }

    if t == 3 {
        return [0, 0, 0, 1];
    }

    if t == 4 {
        return [-1, 0, 0, 0];
    }

    if t == 5 {
        return [0, -1, 0, 0];
    }

    if t == 6 {
        return [0, 0, -1, 0];
    }

    return [0, 0, 0, -1];
}

function z8_inv_pow(k) {
    return z8_pow((8 - (k % 8)) % 8);
}

function fft_exact(a, invert=false) {
    n = len(a);

    if n == 1 {
        return [a[0]];
    }

    even = fft_exact(a[0::2], invert);
    odd = fft_exact(a[1::2], invert);

    y = [];
    i = 0;
    while i < n {
        y = y + [z8_zero()];
        i += 1;
    }

    half = n >> 1;
    k = 0;

    while k < half {
        step = 8 / n;

        if invert {
            wk = z8_inv_pow(step * k);
        } else {
            wk = z8_pow(step * k);
        }

        t = z8_mul(wk, odd[k]);

        y[k] = z8_add(even[k], t);
        y[k + half] = z8_sub(even[k], t);

        k += 1;
    }

    return y;
}

function polymul_fft(a, b) {
    needed = len(a) + len(b) - 1;
    n = next_pow2(needed);

    while len(a) < n {
        a = a + [0];
    }

    while len(b) < n {
        b = b + [0];
    }

    aa = [];
    bb = [];

    i = 0;
    while i < n {
        aa = aa + [z8_from_int(a[i])];
        bb = bb + [z8_from_int(b[i])];
        i += 1;
    }

    fa = fft_exact(aa);
    fb = fft_exact(bb);

    i = 0;
    while i < n {
        fa[i] = z8_mul(fa[i], fb[i]);
        i += 1;
    }

    result = fft_exact(fa, true);

    i = 0;
    while i < n {
        result[i] = z8_div_int(result[i], n);
        i += 1;
    }

    out = [];
    i = 0;
    while i < needed {
        out = out + [int(result[i][0])];
        i += 1;
    }

    return out;
}

a = [1, 2, 3];
b = [4, 5, 6];

print(polymul_fft(a, b));
